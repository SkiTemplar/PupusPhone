# PupusPhone PC side. Copy to .env (git-ignored) or export in your shell; the programs read
# process.env only, they do not load .env files themselves.

# --- Device API on the phone (mcp-server, bridge) -------------------------------------------
# Tailscale IP of the phone (phase 1) or 127.0.0.1 (phase 2, Termux).
PUPUS_PHONE_URL=http://100.64.0.10:8765
# Token shown in the PupusPhone app settings (64 hex chars).
PUPUS_PHONE_TOKEN=
# Optional: per-request timeout and post-action settle delay before re-reading the screen.
PUPUS_PHONE_TIMEOUT_MS=8000
PUPUS_SETTLE_MS=700

# --- Voice bridge ---------------------------------------------------------------------------
# Shared secret also configured in the app (>= 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PUPUS_BRIDGE_TOKEN=
# Bind address. Default 127.0.0.1 (USB with adb reverse, or Termux). Use the PC Tailscale IP for remote use.
# Never use 0.0.0.0 on untrusted networks: the bridge drives your phone.
PUPUS_BRIDGE_HOST=127.0.0.1
PUPUS_BRIDGE_PORT=8766
# claude-sonnet-5-5 (default) or claude-haiku-5-5 for faster simple commands.
PUPUS_MODEL=claude-sonnet-5-5
# Reasoning effort passed as --effort (low|medium|high|xhigh|max); empty = CLI default.
PUPUS_EFFORT=low
# Optional overrides.
# PUPUS_CLAUDE_BIN=claude
# PUPUS_BRIDGE_WORKDIR=        (default: <os tmpdir>/pupusphone-bridge)
# PUPUS_SYSTEM_PROMPT_FILE=    (default: packages/bridge/prompts/voice-system-prompt.md)
# PUPUS_TURN_TIMEOUT_MS=120000
# PUPUS_INTERRUPT_TIMEOUT_MS=3000
# PUPUS_CLAUDE_ENV_PASSTHROUGH=   (comma-separated extra env vars for the claude process)

# --- Fake phone (development) ---------------------------------------------------------------
# PUPUS_FAKE_PHONE_PORT=8765
# PUPUS_FAKE_PHONE_HOST=127.0.0.1
# PUPUS_FAKE_PHONE_LATENCY_MS=0

# Logging (stderr): debug|info|warn|error
PUPUS_LOG_LEVEL=info
