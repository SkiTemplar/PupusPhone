<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Estado -->
            <TextView style="@style/GroupTitle" android:paddingTop="8dp" android:text="@string/group_status" />
            <LinearLayout style="@style/Card">
                <TextView android:id="@+id/diagA11yText" style="@style/BodyText" android:paddingTop="0dp" android:textStyle="bold" />
                <TextView android:id="@+id/diagApiText" style="@style/BodyText" />
                <TextView android:id="@+id/diagBridgeText" style="@style/BodyText" />
                <TextView android:id="@+id/diagTermuxText" style="@style/BodyText" />
                <TextView android:id="@+id/diagSecureText" style="@style/BodyText" />
                <LinearLayout
                    android:id="@+id/diagGrantGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/HelpText" android:text="@string/diag_grant_help" />
                    <TextView
                        android:id="@+id/diagGrantCommand"
                        style="@style/BodyText"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />
                    <Button android:id="@+id/diagCopyGrantButton" style="@style/SecondaryButton" android:text="@string/diag_copy_command" />
                </LinearLayout>
                <TextView android:id="@+id/diagBatteryText" style="@style/BodyText" />
                <Button android:id="@+id/diagBatteryButton" style="@style/SecondaryButton" android:text="@string/diag_battery_request" />
                <TextView android:id="@+id/diagMusicText" style="@style/BodyText" />
                <Button android:id="@+id/diagMusicButton" style="@style/SecondaryButton" android:text="@string/music_access_grant" />
                <TextView android:id="@+id/diagXiaomiTip" style="@style/HelpText" android:text="@string/diag_xiaomi_tip" android:textColor="@color/warning" />
                <Button android:id="@+id/diagRepairButton" style="@style/PrimaryButton" android:layout_marginTop="16dp" android:text="@string/diag_repair" />
            </LinearLayout>

            <!-- Conexión -->
            <TextView style="@style/GroupTitle" android:text="@string/group_connection" />
            <LinearLayout style="@style/Card">
                <TextView style="@style/FieldLabel" android:paddingTop="0dp" android:text="@string/bridge_url" />
                <EditText
                    android:id="@+id/bridgeUrlInput"
                    style="@style/SettingsInput"
                    android:hint="@string/bridge_url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
                <TextView style="@style/FieldLabel" android:text="@string/bridge_token" />
                <EditText
                    android:id="@+id/bridgeTokenInput"
                    style="@style/SettingsInput"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
                <Switch
                    android:id="@+id/termuxSwitch"
                    style="@style/BodyText"
                    android:layout_marginTop="16dp"
                    android:minHeight="56dp"
                    android:text="@string/termux_launch"
                    android:textStyle="bold" />
                <TextView style="@style/FieldLabel" android:text="@string/termux_script_path" />
                <EditText
                    android:id="@+id/termuxPathInput"
                    style="@style/SettingsInput"
                    android:fontFamily="monospace"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:textSize="14sp" />
                <TextView android:id="@+id/termuxStatusText" style="@style/BodyText" android:paddingTop="8dp" android:textStyle="bold" />
                <Button
                    android:id="@+id/termuxPermissionButton"
                    style="@style/SecondaryButton"
                    android:text="@string/termux_grant_permission"
                    android:visibility="gone" />
                <TextView style="@style/HelpText" android:text="@string/termux_launch_help" />
                <Button
                    android:id="@+id/termuxSetupButton"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/termux_setup" />
                <TextView style="@style/HelpText" android:text="@string/termux_setup_help" />
                <TextView style="@style/FieldLabel" android:paddingTop="16dp" android:text="@string/navigation_apps" />
                <EditText
                    android:id="@+id/navigationAppsInput"
                    style="@style/SettingsInput"
                    android:fontFamily="monospace"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textMultiLine"
                    android:textSize="14sp" />
                <TextView style="@style/HelpText" android:text="@string/navigation_apps_help" />
                <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:layout_marginTop="16dp" android:text="@string/save" />

                <TextView style="@style/FieldLabel" android:paddingTop="24dp" android:text="@string/device_token" />
                <TextView
                    android:id="@+id/deviceTokenText"
                    style="@style/BodyText"
                    android:fontFamily="monospace"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/showTokenButton"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/show" />
                    <Button
                        android:id="@+id/copyTokenButton"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/copy" />
                </LinearLayout>
                <Button android:id="@+id/regenerateTokenButton" style="@style/SecondaryButton" android:text="@string/regenerate_token" />

                <TextView style="@style/FieldLabel" android:paddingTop="24dp" android:text="@string/device_ips" />
                <TextView
                    android:id="@+id/ipText"
                    style="@style/BodyText"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Voz -->
            <TextView style="@style/GroupTitle" android:text="@string/group_voice" />
            <LinearLayout style="@style/Card">
                <TextView android:id="@+id/pauseLabel" style="@style/BodyText" android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/pauseSeek"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:contentDescription="@string/pause_to_send_help" />
                <TextView style="@style/HelpText" android:text="@string/pause_to_send_help" />

                <TextView style="@style/BodyText" android:paddingTop="24dp" android:text="@string/recognizer_title" android:textStyle="bold" />
                <RadioGroup
                    android:id="@+id/recognizerGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp">
                    <RadioButton android:id="@+id/recognizerAuto" style="@style/Choice" android:text="@string/recognizer_auto" />
                    <RadioButton android:id="@+id/recognizerOnDevice" style="@style/Choice" android:text="@string/recognizer_on_device" />
                    <RadioButton android:id="@+id/recognizerDefault" style="@style/Choice" android:text="@string/recognizer_default" />
                </RadioGroup>

                <TextView android:id="@+id/ttsVolumeLabel" style="@style/BodyText" android:paddingTop="24dp" android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/ttsVolumeSeek"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:contentDescription="@string/tts_volume_help" />
                <TextView style="@style/HelpText" android:text="@string/tts_volume_help" />

                <TextView android:id="@+id/minMediaLabel" style="@style/BodyText" android:paddingTop="24dp" android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/minMediaSeek"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:contentDescription="@string/min_media_volume_help" />
                <TextView style="@style/HelpText" android:text="@string/min_media_volume_help" />

                <Switch
                    android:id="@+id/silentToneSwitch"
                    style="@style/BodyText"
                    android:layout_marginTop="16dp"
                    android:minHeight="56dp"
                    android:text="@string/silent_done_tone"
                    android:textStyle="bold" />
                <TextView style="@style/HelpText" android:text="@string/silent_done_tone_help" />
            </LinearLayout>

            <!-- Seguridad -->
            <TextView style="@style/GroupTitle" android:text="@string/group_security" />
            <LinearLayout style="@style/Card">
                <Switch
                    android:id="@+id/allowLanSwitch"
                    style="@style/BodyText"
                    android:minHeight="56dp"
                    android:text="@string/allow_lan"
                    android:textStyle="bold" />
                <TextView style="@style/HelpText" android:text="@string/allow_lan_warning" android:textColor="@color/warning" />
            </LinearLayout>

            <!-- Permisos -->
            <TextView style="@style/GroupTitle" android:text="@string/group_permissions" />
            <LinearLayout style="@style/Card">
                <TextView android:id="@+id/accessibilityText" style="@style/BodyText" android:textStyle="bold" />
                <Button android:id="@+id/accessibilityButton" style="@style/SecondaryButton" android:layout_marginTop="16dp" android:text="@string/open_accessibility" />
                <Button android:id="@+id/batteryButton" style="@style/SecondaryButton" android:text="@string/open_battery" />
                <Button android:id="@+id/permissionsButton" style="@style/SecondaryButton" android:text="@string/grant_permissions" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
