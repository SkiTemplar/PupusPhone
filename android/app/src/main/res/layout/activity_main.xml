<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar: name, settings and status chips. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/IconButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/a11yChip"
            style="@style/Chip"
            android:text="@string/chip_a11y_off" />

        <TextView
            android:id="@+id/bridgeChip"
            style="@style/Chip"
            android:layout_marginStart="8dp"
            android:text="@string/chip_bridge_off" />
    </LinearLayout>

    <!-- The button: about 70 % of the width, centred. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.pupus.phone.ui.PttCircleView
            android:id="@+id/pttCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/stateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/state_disconnected"
        android:textColor="@color/ptt_stopped"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Fixed line counts so the button does not jump while text arrives. -->
    <TextView
        android:id="@+id/transcriptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="start"
        android:gravity="center"
        android:lines="3"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/replyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp" />

    <!-- Car mode: the whole card toggles the switch. -->
    <LinearLayout
        android:id="@+id/carModeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_clickable"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_mode"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_mode_help"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/carModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:contentDescription="@string/car_mode" />
    </LinearLayout>

    <Button
        android:id="@+id/resetButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/new_conversation"
        android:textAllCaps="false"
        android:textColor="@color/accent"
        android:textSize="16sp" />
</LinearLayout>
